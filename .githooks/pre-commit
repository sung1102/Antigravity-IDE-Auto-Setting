#!/bin/sh
echo "[pre-commit] Running Antigravity-IDE-Auto-Setting verification lever..."
if command -v powershell >/dev/null 2>&1; then
  powershell -ExecutionPolicy Bypass -File "./scripts/verify-repo.ps1" || exit 1
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -File "./scripts/verify-repo.ps1" || exit 1
else
  echo "[pre-commit] Error: PowerShell not found; cannot execute scripts/verify-repo.ps1."
  exit 1
fi
